{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockquant.local/contracts/strategy-request.v1.json",
  "title": "FactorComputeRequest v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","request_id","mode","strategy_id","strategy_version","as_of","snapshot_hash","config_hash","data_ref"],
  "properties": {
    "schema_version": {"const":"v1"},
    "request_id": {"type":"string","minLength":1,"maxLength":128},
    "mode": {"const":"raw_factors"},
    "strategy_id": {"type":"string","minLength":1,"maxLength":80},
    "strategy_version": {"type":"string","minLength":1},
    "as_of": {"type":"string","format":"date","pattern":"^(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-[0-9]{2}-[0-9]{2}$"},
    "snapshot_hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "config_hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "data_ref": {
      "type":"object","additionalProperties":false,
      "required":["kind","path","sha256","format"],
      "properties": {
        "kind":{"const":"local_file"},
        "path":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "format":{"enum":["json","jsonl","parquet"]}
      }
    },
    "params":{"type":"object"}
  }
}
