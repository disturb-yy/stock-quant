# Local mode defaults to fixtures and requires no external credentials.
DATA_PROVIDER=mock

# Optional real provider mode. Supply the token through your local .env or
# secret manager; never commit a real token.
TUSHARE_TOKEN=

# Local development database (used by later implementation tickets).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_quant_dev
DB_USER=stock_quant
DB_PASSWORD=

# Asia/Shanghai trading-date semantics are fixed by the project.
TZ=Asia/Shanghai
